# TEMPLATE, not installed or enabled by anything in this repository. Replace every
# /ABSOLUTE/PATH/... placeholder and the @PROBE_TARGET_IPS@ token (the literal private target
# addresses from the probe config, space separated); render.py does the token for you when the
# `probes_enabled` key is set. See "Probes" in docs/monitoring.md.
#
# Like ntfy-sender.service, the probe runs inside `podman unshare` so that, as the root of the
# rootless user namespace, it can write the state file into the probe volume that the pipeline
# container mounts read-only. DO NOT ADD mount-namespace directives (PrivateTmp, ProtectSystem,
# ProtectHome, ReadWritePaths, Protect*) or NoNewPrivileges/RestrictNamespaces/
# CapabilityBoundingSet=/SystemCallFilter=: they can break `podman unshare`
# (deploy/tests/test_probe_render.py enforces this).
#
# Data flow: this unit mounts only the probe output volume; no Vigie data volume is mounted into
# it, and the runner opens only its config and state files. `podman unshare` is kept because who
# owns the probe volume after the pipeline first mounts it is unverified; as the namespace root
# the runner can write the state file either way. IPAddressDeny/IPAddressAllow is defense in depth
# and BEST-EFFORT: it needs cgroup BPF, which a systemd USER manager may not be allowed to load. The
# hard limits are the validated config (at most 10 literal private IPs, no hostnames), the
# connected UDP socket and RestrictAddressFamilies.
[Unit]
Description=Vigie bounded probe (standalone, one pass)
Documentation=file:///ABSOLUTE/PATH/TO/vigie/docs/monitoring.md

[Service]
Type=oneshot
ExecStart=/usr/bin/podman unshare /usr/bin/python3 -I /ABSOLUTE/PATH/TO/vigie/deploy/persistent/probe_runner.py /ABSOLUTE/PATH/TO/private/probe.json --once
TimeoutStartSec=45
UMask=0077
IPAddressDeny=any
IPAddressAllow=@PROBE_TARGET_IPS@
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
