# Vigie server image: ONE image, three services (ingest, pipeline, api) selected by command.
# Build context is the repository root (see compose.yaml). Not yet built in CI; reviewed by hand only.
#
#   podman build -f deploy/Containerfile -t localhost/vigie-server:dev .
#
# Runtime assumptions (compose.yaml sets them): read-only rootfs, /tmp as tmpfs, all
# capabilities dropped, data on /var/lib/vigie, overrides.db on /overrides.

ARG PYTHON_IMAGE=docker.io/library/python:3.12-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.6

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS build
COPY --from=uv /uv /usr/local/bin/uv
# Use the base image's interpreter so the venv's python symlink resolves in the runtime stage.
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
WORKDIR /src
# Dependencies first (cache friendly), then the project itself (non-editable wheel install).
COPY server/pyproject.toml server/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY server/src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM ${PYTHON_IMAGE} AS runtime
# Fixed numeric ids so compose can set secret ownership (uid/gid) without guessing.
ARG VIGIE_UID=10001
RUN groupadd --system --gid ${VIGIE_UID} vigie \
 && useradd --system --uid ${VIGIE_UID} --gid ${VIGIE_UID} --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin vigie \
 && install -d -m 0700 -o vigie -g vigie /var/lib/vigie /overrides
COPY --from=build /opt/venv /opt/venv
COPY deploy/entrypoint.sh deploy/healthcheck.py /usr/local/bin/
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIGIE_DATA_DIR=/var/lib/vigie \
    VIGIE_SECRETS_DIR=/run/secrets
USER vigie:vigie
WORKDIR /var/lib/vigie
VOLUME ["/var/lib/vigie", "/overrides"]
# The entrypoint only wires overrides.db (see entrypoint.sh) and then execs the command.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["python", "-m", "vigie_api", "--help"]
