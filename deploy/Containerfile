# Vigie server image: ONE image, three services (ingest, pipeline, api) selected by command.
# Build context is the repository root (see compose.yaml). Rootless build/runtime validated
# on 2026-10-24; see docs/deployment-validation-2026-10-24.md. Image builds are not yet a CI gate.
#
#   podman build -f deploy/Containerfile -t localhost/vigie-server:dev .
#
# Runtime contract (compose.yaml sets it): read-only rootfs, /tmp as tmpfs, all
# capabilities dropped, three data volumes: /raw (shards), /inv (inventory.db), /overrides.
#
# Base images are pinned by digest (the multi-arch index digest of the tag named next to it),
# looked up on 2026-10-21 through the registries' HTTP APIs and built on 2026-10-24.
# Refresh both together on purpose: deploy/tests/check_refs.py --release fails on an unpinned ARG.
# tag: docker.io/library/python:3.12-slim-bookworm
ARG PYTHON_IMAGE=docker.io/library/python@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
# tag: ghcr.io/astral-sh/uv:0.11.6
ARG UV_IMAGE=ghcr.io/astral-sh/uv@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS build
COPY --from=uv /uv /usr/local/bin/uv
# Use the base image's interpreter so the venv's python symlink resolves in the runtime stage.
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_BUILD_CONSTRAINT=/build-constraints.txt
# hatchling (the build backend) is not in uv.lock; this pins it and its dependencies.
COPY deploy/build-constraints.txt /build-constraints.txt
WORKDIR /src
# Dependencies first (cache friendly), then the project itself (non-editable wheel install).
COPY server/pyproject.toml server/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY server/src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM ${PYTHON_IMAGE} AS runtime
# Fixed numeric ids so compose can set secret ownership (uid/gid) without guessing.
ARG VIGIE_UID=10001
RUN groupadd --system --gid ${VIGIE_UID} vigie \
 && useradd --system --uid ${VIGIE_UID} --gid ${VIGIE_UID} --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin vigie \
 && install -d -m 0700 -o vigie -g vigie /var/lib/vigie /raw /inv /overrides
# The runtime needs no package installer: pip/setuptools/wheel are removed from the final stage
# (the app lives in /opt/venv, built in the build stage). Uninstall first so metadata goes too.
RUN (python -m pip uninstall -y pip setuptools wheel >/dev/null 2>&1 || true) \
 && rm -rf /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12 \
        /usr/local/lib/python3.12/ensurepip /usr/local/lib/python3.12/site-packages/pip \
        /usr/local/lib/python3.12/site-packages/setuptools \
        /usr/local/lib/python3.12/site-packages/wheel \
        /usr/local/lib/python3.12/site-packages/pkg_resources
COPY --from=build /opt/venv /opt/venv
COPY deploy/entrypoint.sh deploy/healthcheck.py /usr/local/bin/
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIGIE_DATA_DIR=/var/lib/vigie \
    VIGIE_SECRETS_DIR=/run/secrets
USER vigie:vigie
WORKDIR /var/lib/vigie
# Compose owns the volume matrix. Image VOLUME declarations would add anonymous
# writable mounts for paths a service deliberately does not mount.
# The entrypoint sets a private creation mask, guards overrides.db, then execs the command.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["python", "-m", "vigie_api", "--help"]
