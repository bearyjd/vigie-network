# Copy to deploy/.env and edit. Contains NO secrets: keys and certificates are podman secrets
# (see gen-certs.sh and provision-collector.sh). Defaults shown are the code defaults.

# --- Network exposure -----------------------------------------------------------------------
# REQUIRED. The LAN address of THIS server that the ports are published on (never 0.0.0.0 by
# default; compose fails when it is unset). Inside the containers the apps listen on 0.0.0.0.
VIGIE_LAN_ADDR=192.168.1.10
VIGIE_INGEST_PORT=8443        # collector -> ingest (POST /v1/batch)
VIGIE_API_PORT=8444           # control app -> API
# Restrict the ingest port to the collector's address on the SERVER HOST (firewalld/nftables):
# traffic between two hosts on the router's LAN bridge never passes the router's firewall.
# Rootless networking matters for the ingest per-peer rate limiter: with slirp4netns the peer
# address the app sees may be rewritten; with pasta it should be the real source. Check:
#   podman info --format '{{.Host.RootlessNetworkCmd}}'

# --- Image ----------------------------------------------------------------------------------
VIGIE_IMAGE_TAG=dev

# --- Ingest (server/src/vigie_ingest/config.py) ---------------------------------------------
VIGIE_SHARD_RETENTION_DAYS=7      # raw shard retention, 1..30 (hard max 30)
VIGIE_MAX_SPOOL_AGE_S=86400       # oldest batch window accepted (seconds)
VIGIE_RATE_LIMIT_PER_MIN=60       # per authenticated collector, charged after the HMAC verifies
VIGIE_RATE_LIMIT_PREAUTH_PER_MIN=120  # per peer address, before authentication
VIGIE_RATE_LIMIT_IPV6_PREFIX=64   # group IPv6 peers by /64; 0 or none = full addresses
VIGIE_MAX_SHARD_DAYS=3            # shard days one batch may touch (else 422)
VIGIE_BODY_TIMEOUT_S=10           # deadline for receiving a request body

# --- Pipeline (server/src/vigie_pipeline/config.py) -----------------------------------------
VIGIE_PIPELINE_INTERVAL_S=30      # seconds between passes (the --loop value)
VIGIE_TRANSIENT_WINDOW_S=86400    # a MAC must be promoted within this window or it retires
VIGIE_TRANSIENT_MIN_DWELL_S=7200  # min first-to-last-seen dwell before promotion
VIGIE_PROMOTION_CAP_PER_HOUR=20   # max transient -> device promotions per hour
VIGIE_MONITORING_LARGE_UPLOAD_BYTES=1073741824 # fixed hourly upload threshold; pipeline only (1GiB)
VIGIE_STITCH_THRESHOLD=0.8        # minimum score for an identity suggestion
VIGIE_OVERLAP_GRACE_S=600         # shared by pipeline and API approval checks
VIGIE_ACTIVITY_GAP_S=300          # silence that separates activity intervals

# --- Incident delivery (docs/monitoring.md, "Incident delivery"). OFF by default. -----------
# While off, nothing is planned, created or expired. Enabling records a watermark the first time,
# so incidents detected before that instant are never announced. Only 1/true/yes enable; garbage
# is a startup error. The only publisher today appends JSON lines to a local file (0600).
VIGIE_DELIVERY_ENABLED=0
VIGIE_DELIVERY_FILE=              # REQUIRED when enabled; must be under a pipeline-writable mount: with the stock compose that is the inventory volume, e.g. /inv/delivery-messages.jsonl
VIGIE_DELIVERY_LEASE_S=300        # sender lease, >= 60 and >= 2x the transmit deadline
VIGIE_DELIVERY_TRANSMIT_DEADLINE_S=30  # hard wall timeout of one publish
VIGIE_DELIVERY_MAX_ATTEMPTS=6     # claims per delivery before it is marked failed
VIGIE_DELIVERY_BACKOFF_BASE_S=60  # retry delay after the 1st failure, doubling
VIGIE_DELIVERY_BACKOFF_CAP_S=3600 # largest retry delay
VIGIE_DELIVERY_TTL_S=86400        # a pending delivery older than this expires
VIGIE_DELIVERY_RETENTION_S=2592000 # delivery rows are kept this long (30 days)
VIGIE_DELIVERY_MAX_PER_RUN=20     # most messages one pipeline pass may send
VIGIE_DELIVERY_DRAIN_BUDGET_S=60  # a pass claims nothing new once its drain has run this long (>= the transmit deadline)
VIGIE_DELIVERY_MAX_ABANDONED=2    # publishes abandoned at their deadline and still hung; at this many sending stops (>= 1)

# --- API (server/src/vigie_api/config.py) ---------------------------------------------------
VIGIE_API_RATE_LIMIT=120          # requests per window per token
VIGIE_API_RATE_WINDOW_S=60
VIGIE_API_MAX_BODY_BYTES=16384
VIGIE_API_MAX_MERGE_ALIASES=256
VIGIE_API_MAX_MERGE_OBSERVATIONS=1024
VIGIE_API_MAX_MERGE_ACTIVITY_ROWS=8192
VIGIE_API_MAX_MERGE_FLATTEN_WRITES=256
VIGIE_API_INCIDENT_SNOOZE_MAX_S=604800   # longest incident snooze a client may request (7 days; minimum 120)

# --- Not set here on purpose ----------------------------------------------------------------
# VIGIE_INSECURE_DEV=1 serves plain HTTP. Development only; never put it in this file.
# VIGIE_DATA_DIR (/raw: shards), VIGIE_INVENTORY_PATH (/inv/inventory.db), VIGIE_OVERRIDES_PATH
# (/overrides/overrides.db, api and pipeline only) and VIGIE_SECRETS_DIR are fixed by compose.yaml,
# as are VIGIE_GUARD_OVERRIDES (entrypoint check) and VIGIE_HEALTH_FILE (pipeline heartbeat).
# Event/hostname retention (PRP section 9, 90 days) is not implemented yet: no setting exists.
