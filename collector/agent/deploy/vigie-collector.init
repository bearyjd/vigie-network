#!/bin/sh /etc/rc.common
# procd init script TEMPLATE for the Vigie collector (OpenWrt / GL.iNet). NOT yet run on the
# router. Install: /etc/init.d/vigie-collector (chmod 755), then `enable` and `start`.
#
# Layout (see docs/spikes/p2-collector-agent.md):
#   /usr/bin/vigie-collector                       unprivileged agent
#   /usr/libexec/vigie/vigie-dnsmasq-dropin.sh     root helper (this script runs it)
#   /usr/libexec/vigie/vigie-log-watchdog.sh       root cron, every 5 min
#   /etc/vigie/collector.conf                      0644, no secrets
#   /etc/vigie/key                                 0600, owner nobody, hex HMAC key
#
# cron (root):  */5 * * * * /usr/libexec/vigie/vigie-dnsmasq-dropin.sh ensure; /usr/libexec/vigie/vigie-log-watchdog.sh

START=95
STOP=10
USE_PROCD=1

start_service() {
	# Recreate the tmpfs drop-in and reload dnsmasq (root).
	/usr/libexec/vigie/vigie-dnsmasq-dropin.sh ensure || return 1

	procd_open_instance
	procd_set_param command /usr/bin/vigie-collector --config /etc/vigie/collector.conf
	# procd drops to this user itself (no ujail needed). Unverified on this firmware.
	procd_set_param user nobody
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
