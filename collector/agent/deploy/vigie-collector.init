#!/bin/sh /etc/rc.common
# procd init script TEMPLATE for the Vigie collector (OpenWrt / GL.iNet). NOT yet run on the
# router. Install: /etc/init.d/vigie-collector (chmod 755), then `enable` and `start`.
#
# Layout (see docs/spikes/p2-collector-agent.md):
#   /usr/bin/vigie-collector                       unprivileged agent
#   /usr/libexec/vigie/vigie-dnsmasq-dropin.sh     root helper (this script runs it)
#   /usr/libexec/vigie/vigie-log-watchdog.sh       root cron, every 5 min
#   /usr/libexec/vigie/vigie-run.sh                procd command wrapper (counts exits 77/78)
#   /etc/vigie/collector.conf                      0644, no secrets
#   /usr/libexec/vigie/vigie-lib.sh                sourced by both root scripts
#   /etc/vigie/key                                 0600, owner vigie, hex HMAC key
#   user/group `vigie` (dedicated, NOT nobody): see vigie-print-install-commands.sh
#
# cron (root):  */5 * * * * /usr/libexec/vigie/vigie-dnsmasq-dropin.sh ensure; /usr/libexec/vigie/vigie-log-watchdog.sh

# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	PATH=/usr/sbin:/usr/bin:/sbin:/bin
	export PATH
	# Reboot/mount loss must not fall back to the shared /tmp filesystem.
	/usr/libexec/vigie/vigie-logfs.sh check || return 1
	# Resolve the existing dedicated account as root. Never fall back to root/nobody or
	# accept shell fragments, aliases or sentinel IDs as launcher arguments.
	if ! UID_N=$(id -u vigie) || ! GID_N=$(id -g vigie); then
		logger -t vigie 'vigie user missing or invalid group'
		return 1
	fi
	case "$UID_N:$GID_N" in *[!0-9:]*) return 1 ;; esac
	case "$UID_N" in '' | 0*) return 1 ;; esac
	case "$GID_N" in '' | 0*) return 1 ;; esac
	if ! [ "$UID_N" -ge 1000 ] || ! [ "$UID_N" -le 4294967294 ] || [ "$UID_N" -eq 65534 ] ||
	   ! [ "$GID_N" -ge 1000 ] || ! [ "$GID_N" -le 4294967294 ] || [ "$GID_N" -eq 65534 ]; then
		logger -t vigie 'unsafe vigie uid/gid'
		return 1
	fi
	# Prepare a trusted parent and private counter child before any DNS mutation.
	/usr/libexec/vigie/vigie-state-dir.sh || return 1
	# Recreate the tmpfs drop-in and reload dnsmasq (root).
	/usr/libexec/vigie/vigie-dnsmasq-dropin.sh ensure || return 1

	procd_open_instance
	# procd starts this audited transition as root. Do not set procd user/group here:
	# the helper requires real+effective root, then verifies complete privilege removal
	# before executing the root-owned wrapper as the dedicated unprivileged account.
	procd_set_param command /usr/bin/vigie-privdrop "$UID_N" "$GID_N" /usr/libexec/vigie/vigie-run.sh --config /etc/vigie/collector.conf
	procd_set_param limits core="0 0"
	# Retry limit 5 (not infinite): exits 77/78 (root refused, bad config) never fix themselves.
	# vigie-run.sh logs when the limit is reached. Unverified on this firmware: procd's exact
	# off-by-one semantics.
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}
